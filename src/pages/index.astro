---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Portfolio in development">
  <section class="mx-auto flex min-h-dvh max-w-2xl flex-col justify-center px-6 py-16">
    <p class="text-sm font-medium uppercase tracking-widest text-slate-500">Phase 1 skeleton</p>
    <h1 class="mt-3 text-3xl font-semibold sm:text-4xl">Portfolio in development</h1>
    <p class="mt-4 text-lg text-slate-700">
      This page confirms the build and deployment pipeline. Content, design tokens and the homepage
      design will be added in later phases, after approval.
    </p>
  </section>
</BaseLayout>
