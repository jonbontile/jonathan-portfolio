---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <section class="mx-auto flex min-h-dvh max-w-2xl flex-col justify-center px-6 py-16">
    <p class="text-sm font-medium uppercase tracking-widest text-slate-500">Error 404</p>
    <h1 class="mt-3 text-3xl font-semibold sm:text-4xl">Page not found</h1>
    <p class="mt-4 text-lg text-slate-700">The page you were looking for doesn't exist or has moved.</p>
    <p class="mt-6">
      <a href="/" class="font-medium underline underline-offset-4">Go to the homepage</a>
    </p>
  </section>
</BaseLayout>
