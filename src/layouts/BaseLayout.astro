---
import '../styles/global.css';
import Seo from '../components/common/Seo.astro';
import { assertPublishableContent } from '../lib/content';

// Production builds fail here if any approved content isn't publishable.
await assertPublishableContent();

interface Props {
  title: string;
  description?: string;
  isHome?: boolean;
}

const { title, description, isHome } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Seo title={title} description={description} isHome={isHome} />
  </head>
  <body class="min-h-dvh antialiased">
    <a
      href="#main"
      class="sr-only rounded-md bg-white px-4 py-2 font-medium text-navy-900 focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50"
    >
      Skip to main content
    </a>
    <slot name="header" />
    <main id="main" tabindex="-1" class="focus:outline-none">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
