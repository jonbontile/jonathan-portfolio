---
/**
 * Full site chrome: header, main content, footer.
 * Used by preview pages now and by every real page from Phase 3 onward.
 */
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  isHome?: boolean;
}

const { title, description, isHome } = Astro.props;
---

<BaseLayout title={title} description={description} isHome={isHome}>
  <SiteHeader slot="header" />
  <slot />
  <SiteFooter slot="footer" />
</BaseLayout>
