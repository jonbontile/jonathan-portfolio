---
/**
 * Visible marker for a missing fact. Renders the literal text
 * "[INFORMATION NEEDED: ...]" so the production build guard refuses to publish
 * any page that still contains one. Styling lives in global.css (.info-needed),
 * shared with markers inside Markdown content and <Fact>.
 */
interface Props {
  need: string;
}

const { need } = Astro.props;
---

<mark class="info-needed">[INFORMATION NEEDED: {need}]</mark>
