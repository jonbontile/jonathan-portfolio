---
/**
 * Button or link styled as a button.
 * primary: accent fill with navy text (4.78:1). Never white text on the accent.
 * secondary: navy outline. inverse: for navy surfaces.
 */
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'secondary' | 'inverse';

interface Props {
  href?: string;
  variant?: Variant;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  [key: string]: unknown;
}

const { href, variant = 'primary', type = 'button', class: className = '', ...rest } = Astro.props as Props &
  HTMLAttributes<'a'>;

const base =
  'btn inline-flex min-h-12 items-center justify-center gap-2 rounded-md px-6 py-3 font-display text-base font-semibold no-underline transition-colors duration-150 hover:no-underline disabled:cursor-not-allowed disabled:opacity-60';

const variants: Record<Variant, string> = {
  // Hover/pressed get LIGHTER, because darker orange drops navy-text contrast below
  // 4.5:1 (#E63D00 = 3.96). Hover #FF6A33 = 5.79:1, pressed #FF7A47 = 6.39:1.
  primary: 'bg-accent text-navy-900 hover:bg-[#ff6a33] active:bg-[#ff7a47]',
  secondary:
    'border-2 border-navy-900 bg-transparent text-navy-900 hover:bg-navy-900 hover:text-white active:bg-navy-950',
  inverse: 'border-2 border-white bg-transparent text-white hover:bg-white hover:text-navy-900',
};

const classes = `${base} ${variants[variant]} ${className}`;
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} {...rest}>
      <slot />
    </button>
  )
}
