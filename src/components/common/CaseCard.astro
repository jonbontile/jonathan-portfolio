---
/**
 * Case study card, used on the homepage and the case studies index.
 * The whole card is clickable through its single title link.
 * data-* attributes feed the index page's filter.
 */
import type { CollectionEntry } from 'astro:content';
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import Fact from '../ui/Fact.astro';
import { isDraft } from '../../lib/content';
import { engagementLabel, progressLabel } from '../../lib/labels';

interface Props {
  entry: CollectionEntry<'caseStudies'>;
}

const { entry: c } = Astro.props;
const services = c.data.services.map((s) => s.id).join(' ');
---

<Card
  as="li"
  interactive
  class="flex flex-col"
  data-case
  data-engagement={c.data.engagementType ?? 'unspecified'}
  data-services={services}
>
  <div class="flex flex-wrap gap-2">
    {isDraft(c) && <Badge tone="outline">Draft</Badge>}
    {c.data.engagementType && <Badge>{engagementLabel[c.data.engagementType]}</Badge>}
    {c.data.progress && <Badge tone="outline">{progressLabel[c.data.progress]}</Badge>}
  </div>
  <p class="mt-5 text-small text-muted"><Fact value={c.data.industry} /></p>
  <h3 class="mt-1 text-h4">
    <a href={`/case-studies/${c.id}/`} class="text-navy-900 no-underline after:absolute after:inset-0 hover:underline">
      {c.data.title}
    </a>
  </h3>
  <p class="mt-3 text-small text-muted"><Fact value={c.data.summary} /></p>
  {
    c.data.containsSyntheticData && (
      <p class="mt-4 text-small font-medium text-navy-900">Includes illustrative data, not client figures</p>
    )
  }
</Card>
