---
/**
 * Professional credentials from the qualifications collection.
 * Hidden when there are none. Credential IDs are never shown unless the
 * entry opts in (showCredentialId).
 */
import type { CollectionEntry } from 'astro:content';
import EntryBody from '../ui/EntryBody.astro';
import Section from '../ui/Section.astro';
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import LedgerRule from '../ui/LedgerRule.astro';
import Fact from '../ui/Fact.astro';
import { isDraft } from '../../lib/content';
import { qualificationDates } from '../../lib/labels';

interface Props {
  qualifications: CollectionEntry<'qualifications'>[];
}

const kindLabel = { license: 'License', certification: 'Certification', degree: 'Degree', training: 'Training' };
/** The homepage shows the first six by order; the full list is on /qualifications/. */
const items = [...Astro.props.qualifications].sort((a, b) => a.data.order - b.data.order).slice(0, 6);
---

{
  items.length > 0 && (
    <Section tone="paper" labelledby="credentials-title">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="credentials-title">Credentials</h2>
        <a href="/qualifications/" class="font-medium">
          All qualifications
        </a>
      </div>
      <LedgerRule class="mt-6 mb-10" />
      <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" role="list">
        {items.map((q) => (
          <Card as="li">
            <div class="flex flex-wrap gap-2">
              {isDraft(q) && <Badge tone="outline">Draft</Badge>}
              <Badge>{kindLabel[q.data.kind]}</Badge>
            </div>
            <h3 class="mt-4 text-h4">{q.data.name}</h3>
            <p class="mt-2 text-small text-muted"><Fact value={q.data.issuer} /></p>
            {qualificationDates(q.data) && <p class="tabular mt-1 text-small text-muted">{qualificationDates(q.data)}</p>}
            <div class="mt-3 text-small">
              <EntryBody entry={q} />
            </div>
          </Card>
        ))}
      </ul>
    </Section>
  )
}
