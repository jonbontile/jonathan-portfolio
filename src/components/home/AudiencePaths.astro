---
/**
 * Two audience pathways: freelance clients and employers/recruiters.
 * Each link is a real link; the card is not one giant click target, which keeps
 * screen-reader output clean. Copy is draft for owner approval.
 */
import type { CollectionEntry } from 'astro:content';
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import Placeholder from '../ui/Placeholder.astro';

interface Props {
  profile?: CollectionEntry<'profile'>;
}

const { profile } = Astro.props;
const resume = profile?.data.resumePdf;

const paths = [
  {
    id: 'clients',
    audience: 'For clients',
    title: 'Need reliable books and clear financial reporting?',
    links: [
      { label: 'Services', href: '/services/' },
      { label: 'Case studies', href: '/case-studies/' },
      { label: 'How I work', href: '/about/' },
    ],
  },
  {
    id: 'employers',
    audience: 'For employers and recruiters',
    title: 'Hiring a remote accounting or finance professional?',
    links: [
      { label: 'Experience', href: '/experience/' },
      { label: 'Qualifications', href: '/qualifications/' },
      { label: 'Skills and tools', href: '/about/#skills' },
    ],
  },
];
---

<Section tone="paper" labelledby="paths-title">
  <h2 id="paths-title" class="sr-only">Where to start</h2>
  <div class="grid gap-6 md:grid-cols-2">
    {
      paths.map((path) => (
        <article
          aria-labelledby={`path-${path.id}`}
          class="flex flex-col rounded-lg border border-line border-t-4 border-t-navy-900 bg-white p-7 transition-colors duration-150 focus-within:border-t-accent hover:border-t-accent sm:p-9"
        >
          <p class="text-small font-semibold text-accent-text">{path.audience}</p>
          <h3 id={`path-${path.id}`} class="mt-3">
            {path.title}
          </h3>
          <ul class="mt-6 space-y-2" role="list">
            {path.links.map((l) => (
              <li>
                <a href={l.href} class="font-medium">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
          <div class="mt-8 pt-2 md:mt-auto">
            {path.id === 'clients' ? (
              <Button href="/contact/">Discuss a project</Button>
            ) : resume ? (
              <Button href={resume} variant="secondary" download>
                Download resume (PDF)
              </Button>
            ) : (
              <Placeholder need="resume PDF for the download button" />
            )}
          </div>
        </article>
      ))
    }
  </div>
</Section>
