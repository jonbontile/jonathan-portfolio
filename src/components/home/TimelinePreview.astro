---
/**
 * Career timeline preview: the most recent entries from the experience
 * collection, on the ledger spine. The full list is on /experience/.
 */
import type { CollectionEntry } from 'astro:content';
import Section from '../ui/Section.astro';
import LedgerRule from '../ui/LedgerRule.astro';
import ExperienceItem from '../common/ExperienceItem.astro';
import { sortExperience } from '../../lib/content';

interface Props {
  experience: CollectionEntry<'experience'>[];
}

const entries = sortExperience(Astro.props.experience).slice(0, 4);
---

{
  entries.length > 0 && (
    <Section tone="white" labelledby="timeline-title">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="timeline-title">Career timeline</h2>
        <a href="/experience/" class="font-medium">
          Full experience
        </a>
      </div>
      <LedgerRule class="mt-6 mb-10" />
      <ol class="relative max-w-3xl border-l-2 border-navy-900/15 pl-8" role="list">
        {entries.map((e) => (
          <ExperienceItem entry={e} />
        ))}
      </ol>
    </Section>
  )
}
