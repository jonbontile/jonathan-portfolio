---
/**
 * "Beyond the Numbers": the four-stage working method (approved claims PS-01,
 * PS-02). The stages really are a sequence, so they're numbered and joined by
 * the ledger rule. Each stage expands to an "In practice" note on request
 * (native <details>: keyboard and screen-reader support, works without JS).
 * Stage descriptions are drafts (evidence register PS-04).
 */
import Section from '../ui/Section.astro';
import Placeholder from '../ui/Placeholder.astro';

const stages = [
  { name: 'Understand', note: 'Learn the business, its processes and its records before touching the numbers.' },
  { name: 'Reconcile', note: 'Make the records agree with bank statements, invoices and other source evidence.' },
  { name: 'Analyze', note: 'Turn accurate records into a clear view of performance, costs and cash.' },
  { name: 'Improve', note: 'Recommend and help put in place better processes and controls.' },
];
---

<Section tone="navy" labelledby="method-title">
  <div class="max-w-(--container-prose)">
    <p class="font-display text-small font-semibold text-accent">Beyond the Numbers</p>
    <h2 id="method-title" class="mt-3">Understand, reconcile, analyze, improve</h2>
    <p class="mt-5 text-navy-200">
      <Placeholder need="one-line philosophy statement in Jonathan's words" />
    </p>
  </div>

  <ol class="mt-14 grid gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8" role="list">
    {
      stages.map((s, i) => (
        <li class="stage">
          <div class="flex items-center" aria-hidden="true">
            <span class="grid size-9 shrink-0 place-items-center rounded-full border-2 border-accent font-display text-small font-bold text-white tabular">
              {i + 1}
            </span>
            <span class="ml-3 h-px flex-1 bg-navy-200/35" />
          </div>
          <h3 class="mt-5 text-h4">
            <span class="sr-only">Step {i + 1}: </span>
            {s.name}
          </h3>
          <p class="mt-2 text-small text-navy-200">{s.note}</p>
          <details class="group mt-4">
            <summary class="inline-flex min-h-11 cursor-pointer list-none items-center gap-2 text-small font-semibold text-white [&::-webkit-details-marker]:hidden">
              <svg
                aria-hidden="true"
                class="size-4 transition-transform duration-150 group-open:rotate-90"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M6 3l5 5-5 5" />
              </svg>
              In practice
            </summary>
            <p class="mt-2 text-small text-navy-200">
              <Placeholder need={`a concrete example of "${s.name}" from real work`} />
            </p>
          </details>
        </li>
      ))
    }
  </ol>
  <p class="mt-10 text-small text-navy-200">Stage descriptions are drafts for approval.</p>
</Section>
