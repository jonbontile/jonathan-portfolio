---
/**
 * Selected case studies (up to 3). Shows featured entries first, then others by
 * order. Renders nothing when there are none: no filler cards. In preview builds
 * draft entries appear with a "Draft" badge; production shows approved only.
 */
import type { CollectionEntry } from 'astro:content';
import Section from '../ui/Section.astro';
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import LedgerRule from '../ui/LedgerRule.astro';
import Fact from '../ui/Fact.astro';
import { isDraft } from '../../lib/content';

interface Props {
  cases: CollectionEntry<'caseStudies'>[];
}

const engagementLabel: Record<string, string> = {
  employment: 'Employment',
  freelance: 'Freelance',
  'business-ownership': 'Business ownership',
  independent: 'Independent project',
};

const shown = [...Astro.props.cases]
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order)
  .slice(0, 3);
---

{
  shown.length > 0 && (
    <Section tone="white" labelledby="cases-title">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="cases-title">Selected case studies</h2>
        <a href="/case-studies/" class="font-medium">
          All case studies
        </a>
      </div>
      <LedgerRule class="mt-6 mb-10" />
      <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" role="list">
        {shown.map((c) => (
          <Card as="li" interactive class="flex flex-col">
            <div class="flex flex-wrap gap-2">
              {isDraft(c) && <Badge tone="outline">Draft</Badge>}
              {c.data.engagementType && <Badge>{engagementLabel[c.data.engagementType]}</Badge>}
              {c.data.progress && <Badge tone="outline">{c.data.progress === 'ongoing' ? 'Ongoing' : 'Completed'}</Badge>}
            </div>
            <p class="mt-5 text-small text-muted"><Fact value={c.data.industry} /></p>
            <h3 class="mt-1 text-h4">
              <a href={`/case-studies/${c.id}/`} class="text-navy-900 no-underline after:absolute after:inset-0 hover:underline">
                {c.data.title}
              </a>
            </h3>
            <p class="mt-3 text-small text-muted"><Fact value={c.data.summary} /></p>
            {c.data.containsSyntheticData && (
              <p class="mt-4 text-small font-medium text-navy-900">Includes illustrative data, not client figures</p>
            )}
          </Card>
        ))}
      </ul>
    </Section>
  )
}
