---
/**
 * Selected case studies (up to 3). Shows featured entries first, then others by
 * order. Renders nothing when there are none: no filler cards. In preview builds
 * draft entries appear with a "Draft" badge; production shows approved only.
 */
import type { CollectionEntry } from 'astro:content';
import Section from '../ui/Section.astro';
import LedgerRule from '../ui/LedgerRule.astro';
import CaseCard from '../common/CaseCard.astro';

interface Props {
  cases: CollectionEntry<'caseStudies'>[];
}

const shown = [...Astro.props.cases]
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order)
  .slice(0, 3);
---

{
  shown.length > 0 && (
    <Section tone="white" labelledby="cases-title">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="cases-title">Selected case studies</h2>
        <a href="/case-studies/" class="font-medium">
          All case studies
        </a>
      </div>
      <LedgerRule class="mt-6 mb-10" />
      <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" role="list">
        {shown.map((c) => (
          <CaseCard entry={c} />
        ))}
      </ul>
    </Section>
  )
}
