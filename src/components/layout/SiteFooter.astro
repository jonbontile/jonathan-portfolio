---
/**
 * Site footer on the navy surface.
 * Credential and business line use approved claims ID-01/ID-02 ("CPA
 * (Philippines)") and ID-03 (Founder, Bontile Bookkeeping Services).
 * Contact details and social profiles are still pending (OT-03, MD-03).
 */
import { footerNav } from '../../config/navigation';
import LedgerRule from '../ui/LedgerRule.astro';

const year = new Date().getFullYear();
---

<footer class="bg-navy-900 text-navy-200">
  <div class="mx-auto w-full max-w-(--container-page) px-4 py-14 sm:px-6 lg:px-8">
    <LedgerRule tone="dark" class="mb-10" />
    <div class="grid gap-10 md:grid-cols-[2fr_1fr]">
      <div>
        <p class="font-display text-xl font-bold text-white">Jonathan Bontile</p>
        <p class="mt-3 max-w-(--container-prose) text-small">
          CPA (Philippines). Founder of <a href="https://bontilebiz.com/" class="text-white">Bontile Bookkeeping Services</a>.
        </p>
      </div>
      <nav aria-label="Footer">
        <ul class="grid grid-cols-2 gap-x-6 gap-y-2" role="list">
          {
            footerNav.map((item) => (
              <li>
                <a href={item.href} class="text-small text-navy-200 hover:text-white">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
    <p class="mt-12 border-t border-navy-200/20 pt-6 text-small">
      <span class="tabular">© {year}</span> Jonathan Bontile. Case studies are anonymized.
    </p>
  </div>
</footer>
