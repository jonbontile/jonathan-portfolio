---
/**
 * Privacy notice: DRAFT, from SECURITY_AND_PRIVACY.md section 10.
 * Needs owner input (retention, privacy contact, email provider confirmation)
 * and an appropriate legal review before publication.
 * Staged page (preview-only).
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/common/PageHeader.astro';
import Section from '../components/ui/Section.astro';
import Placeholder from '../components/ui/Placeholder.astro';
---

<SiteLayout title="Privacy notice" description="How information sent through this site is used.">
  <PageHeader title="Privacy notice" draft>
    <p class="mt-5 max-w-(--container-prose) text-muted">
      Last updated: <Placeholder need="publication date" />
    </p>
    <p class="mt-3 max-w-(--container-prose) text-small text-muted">
      Draft for review. This notice needs legal review before publication.
    </p>
  </PageHeader>

  <Section tone="white">
    <div class="privacy max-w-(--container-prose)">
      <h2>Who is responsible</h2>
      <p>
        Jonathan Bontile is responsible for information sent through this website. For privacy questions, contact
        <Placeholder need="privacy contact address" />.
      </p>

      <h2>What is collected</h2>
      <p>When you use the contact form: your name, email address, inquiry type and message, plus your company and subject if you add them.</p>
      <p>
        Page visits are counted with Cloudflare Web Analytics, which produces aggregated statistics and does not use cookies or
        track you across sites.
      </p>

      <h2>Why it is used</h2>
      <p>Your details are used only to reply to your inquiry. They are never sold or used for marketing.</p>
      <p><Placeholder need="lawful basis wording, confirmed for the applicable laws" /></p>

      <h2>Who processes it</h2>
      <ul>
        <li>Cloudflare: hosting, security, spam protection (Turnstile) and visit statistics.</li>
        <li>
          Email delivery provider: <Placeholder need="provider confirmed at gate 7 (proposed: Resend, data stored in the United States, logs kept 30 days)" />
        </li>
        <li>Google Workspace: the inbox where inquiries are received.</li>
      </ul>

      <h2>International transfers</h2>
      <p>These providers may process your information outside your country, including in the United States.</p>

      <h2>How long it is kept</h2>
      <p>
        Inquiry emails are kept for <Placeholder need="retention period, e.g. 24 months" /> and then deleted. The website itself
        doesn't store form submissions.
      </p>

      <h2>Cookies</h2>
      <p>
        This site sets no tracking cookies. The spam check on the contact form may use strictly necessary signals to tell people
        from automated programs.
      </p>

      <h2>Your rights</h2>
      <p>
        You can ask to access, correct or delete the information you sent, or object to how it's used, by writing to the
        privacy contact above. You can also complain to the National Privacy Commission of the Philippines or to the data
        protection authority where you live.
      </p>

      <h2>Security</h2>
      <p>Information is sent over encrypted connections, and access to inquiries is restricted.</p>

      <h2>Changes</h2>
      <p>If this notice changes, the date at the top will change too.</p>
    </div>
  </Section>
</SiteLayout>

<style>
  .privacy :global(h2) {
    font-size: var(--text-h3);
    line-height: var(--text-h3--line-height);
    margin-top: 2.5rem;
  }
  .privacy :global(h2:first-child) {
    margin-top: 0;
  }
  .privacy :global(p),
  .privacy :global(ul) {
    margin-top: 1rem;
  }
  .privacy :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .privacy :global(li + li) {
    margin-top: 0.5rem;
  }
</style>
