---
/**
 * Case studies index with a filter by engagement type.
 * Progressive enhancement: without JS every case shows and the filter stays
 * hidden. With JS, toggle buttons (aria-pressed) filter the list and a polite
 * live region announces the result count.
 * Staged page (preview-only) until its content is approved.
 */
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHeader from '../../components/common/PageHeader.astro';
import Section from '../../components/ui/Section.astro';
import Placeholder from '../../components/ui/Placeholder.astro';
import CaseCard from '../../components/common/CaseCard.astro';
import { getPublished, isDraft, byOrder } from '../../lib/content';
import { engagementLabel } from '../../lib/labels';

const cases = byOrder(await getPublished('caseStudies'));
const present = Object.entries(engagementLabel).filter(([key]) => cases.some((c) => c.data.engagementType === key));
const unspecified = cases.filter((c) => !c.data.engagementType).length;
---

<SiteLayout title="Case studies" description="Anonymized examples of bookkeeping, accounting and reporting work.">
  <PageHeader
    title="Case studies"
    intro="Anonymized examples of real work: the context, what was done, and what changed. Results appear only where they're documented."
    draft={cases.some(isDraft)}
  />

  <Section tone="white" labelledby="cases-title">
    <h2 id="cases-title" class="sr-only">All case studies</h2>
    {
      cases.length === 0 ? (
        <Placeholder need="approved case studies (evidence register CS-01 onward)" />
      ) : (
        <>
          <div class="case-filter mb-8" hidden>
            <p id="filter-label" class="text-small font-semibold text-navy-900">
              Filter by type of engagement
            </p>
            <div class="mt-3 flex flex-wrap gap-2" role="group" aria-labelledby="filter-label">
              <button type="button" class="filter-btn" data-filter="all" aria-pressed="true">
                All
              </button>
              {present.map(([key, label]) => (
                <button type="button" class="filter-btn" data-filter={key} aria-pressed="false">
                  {label}
                </button>
              ))}
              {unspecified > 0 && (
                <button type="button" class="filter-btn" data-filter="unspecified" aria-pressed="false">
                  Type not yet confirmed
                </button>
              )}
            </div>
            <p class="filter-status mt-4 text-small text-muted" role="status" aria-live="polite" />
          </div>
          <ul class="case-list grid gap-6 md:grid-cols-2 lg:grid-cols-3" role="list">
            {cases.map((c) => (
              <CaseCard entry={c} />
            ))}
          </ul>
        </>
      )
    }
  </Section>
</SiteLayout>

<style>
  .filter-btn {
    min-height: 2.75rem;
    border-radius: 9999px;
    border: 1px solid var(--color-border-strong);
    background: var(--color-white);
    padding: 0.5rem 1rem;
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--color-ink);
    cursor: pointer;
    transition: background-color 150ms, color 150ms;
  }
  .filter-btn:hover {
    border-color: var(--color-navy-900);
  }
  .filter-btn[aria-pressed='true'] {
    background: var(--color-navy-900);
    border-color: var(--color-navy-900);
    color: var(--color-white);
  }
</style>

<script>
  const filter = document.querySelector<HTMLElement>('.case-filter');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-case]')];
  const status = filter?.querySelector<HTMLElement>('.filter-status');

  if (filter && cards.length > 1) {
    filter.hidden = false;
    const buttons = [...filter.querySelectorAll<HTMLButtonElement>('.filter-btn')];

    const apply = (value: string) => {
      let shown = 0;
      for (const card of cards) {
        const match = value === 'all' || card.dataset.engagement === value;
        card.hidden = !match;
        if (match) shown++;
      }
      for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.filter === value));
      if (status) status.textContent = `Showing ${shown} of ${cards.length} case studies`;
    };

    for (const b of buttons) b.addEventListener('click', () => apply(b.dataset.filter ?? 'all'));
  }
</script>
