---
/**
 * Services: deliverables, boundaries and fit (CONTENT_STRATEGY.md).
 * Staged page (preview-only) until its content is approved.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/common/PageHeader.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';
import Fact from '../components/ui/Fact.astro';
import Placeholder from '../components/ui/Placeholder.astro';
import EntryBody from '../components/ui/EntryBody.astro';
import { getPublished, isDraft, byOrder } from '../lib/content';

const services = byOrder(await getPublished('services'));
const audienceLabel = { clients: 'For clients', employers: 'For employers', both: 'For clients and employers' };
---

<SiteLayout title="Services" description="Bookkeeping, accounting and financial reporting services.">
  <PageHeader
    title="Services"
    intro="What each service includes, what it doesn't, and who it suits. Work is done remotely in QuickBooks Online, Xero or Zoho Books."
    draft={services.some(isDraft)}
  >
    <p class="mt-4 max-w-(--container-prose) text-small text-muted">
      Bontile Bookkeeping Services is not a licensed CPA firm in the United States and does not provide audit, attest, legal
      or US income tax return services.
    </p>
  </PageHeader>

  {
    services.length === 0 ? (
      <Section>
        <Placeholder need="services (evidence register SV-01, SV-02)" />
      </Section>
    ) : (
      services.map((s, i) => (
        <Section tone={i % 2 === 0 ? 'white' : 'paper'} labelledby={`service-${s.id}`}>
          <div class="grid gap-10 lg:grid-cols-[5fr_7fr] lg:gap-16">
            <div>
              <div class="flex flex-wrap gap-2">
                {isDraft(s) && <Badge tone="outline">Draft</Badge>}
                <Badge>{audienceLabel[s.data.audience]}</Badge>
              </div>
              <h2 id={`service-${s.id}`} class="mt-4">
                {s.data.title}
              </h2>
              <p class="mt-4 text-muted">
                <Fact value={s.data.summary} />
              </p>
            </div>
            <div class="grid gap-8 sm:grid-cols-2">
              <div>
                <h3 class="text-h4">What's included</h3>
                {s.data.deliverables.length ? (
                  <ul class="mt-3 list-disc space-y-1 pl-5 text-small">
                    {s.data.deliverables.map((d) => (
                      <li>{d}</li>
                    ))}
                  </ul>
                ) : (
                  <p class="mt-3">
                    <Placeholder need="deliverables" />
                  </p>
                )}
              </div>
              <div>
                <h3 class="text-h4">Not included</h3>
                {s.data.boundaries.length ? (
                  <ul class="mt-3 list-disc space-y-1 pl-5 text-small">
                    {s.data.boundaries.map((b) => (
                      <li>{b}</li>
                    ))}
                  </ul>
                ) : (
                  <p class="mt-3">
                    <Placeholder need="boundaries, e.g. whether tax filing is offered" />
                  </p>
                )}
              </div>
              <div class="text-small text-muted sm:col-span-2">
                <EntryBody entry={s} />
              </div>
            </div>
          </div>
        </Section>
      ))
    )
  }

  <Section tone="navy" labelledby="services-cta">
    <div class="flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:justify-between">
      <h2 id="services-cta" class="text-h3">Not sure which service fits?</h2>
      <Button href="/contact/?type=freelance-services">Discuss a project</Button>
    </div>
  </Section>
</SiteLayout>
