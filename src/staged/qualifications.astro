---
/**
 * Qualifications: licenses, certifications, degrees and training, grouped by
 * kind. Credential numbers are never shown unless the entry opts in.
 * Staged page (preview-only) until its content is approved.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/common/PageHeader.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Badge from '../components/ui/Badge.astro';
import Fact from '../components/ui/Fact.astro';
import Placeholder from '../components/ui/Placeholder.astro';
import EntryBody from '../components/ui/EntryBody.astro';
import { getPublished, isDraft, byOrder } from '../lib/content';
import { qualificationKindLabel, qualificationDates } from '../lib/labels';

const all = byOrder(await getPublished('qualifications'));
const kinds = ['license', 'certification', 'degree', 'training'] as const;
const groups = kinds.map((k) => ({ kind: k, items: all.filter((q) => q.data.kind === k) }));
const missing: Record<(typeof kinds)[number], string> = {
  license: 'professional license details (CR-01)',
  certification: 'certifications (CR-02 onward), only if verified and current',
  degree: 'degree, institution and year (ED-01)',
  training: 'relevant training, if any',
};
---

<SiteLayout title="Qualifications" description="Professional licenses, certifications and education.">
  <PageHeader
    title="Qualifications"
    intro="Licenses, certifications and education. Verification details are available on request."
    draft={all.length === 0 || all.some(isDraft)}
  />

  {
    groups.map((g, i) => (
      <Section tone={i % 2 === 0 ? 'white' : 'paper'} labelledby={`kind-${g.kind}`}>
        <h2 id={`kind-${g.kind}`} class="text-h3">
          {qualificationKindLabel[g.kind]}
          {g.kind !== 'training' ? 's' : ''}
        </h2>
        {g.items.length === 0 ? (
          <p class="mt-6">
            <Placeholder need={missing[g.kind]} />
          </p>
        ) : (
          <ul class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3" role="list">
            {g.items.map((q) => (
              <Card as="li">
                {isDraft(q) && <Badge tone="outline">Draft</Badge>}
                <h3 class="mt-3 text-h4">{q.data.name}</h3>
                <p class="mt-2 text-small text-muted">
                  <Fact value={q.data.issuer} />
                </p>
                {qualificationDates(q.data) && <p class="tabular mt-1 text-small text-muted">{qualificationDates(q.data)}</p>}
                {q.data.verifyUrl && (
                  <p class="mt-3 text-small">
                    <a href={q.data.verifyUrl} rel="noopener">
                      Verify this credential
                    </a>
                  </p>
                )}
                <div class="mt-3 text-small">
                  <EntryBody entry={q} />
                </div>
              </Card>
            ))}
          </ul>
        )}
      </Section>
    ))
  }
</SiteLayout>
