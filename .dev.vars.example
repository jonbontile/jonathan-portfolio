# Copy to .dev.vars for local development (git-ignored). Never commit real values.
# Cloudflare's published Turnstile test secret (always passes):
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Use a Resend key only from your own account; for local tests point
# RESEND_API_URL at a local mock instead of the real API.
RESEND_API_KEY=
RESEND_API_URL=
CONTACT_TO=
