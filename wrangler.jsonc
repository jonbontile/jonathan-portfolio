{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jonathan-portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only API requests reach the Worker; every other request is served as a
    // static file without invoking Worker code (free and unlimited).
    "run_worker_first": ["/api/*"]
  },
  // Deploy to *.workers.dev only. No custom domain until launch approval (gate 8).
  "workers_dev": true,
  "preview_urls": true,
  // Required by `wrangler preview`, which Workers Builds runs for
  // non-production branches. Without it the preview deploy step fails.
  "previews": {},
  "observability": {
    "enabled": true
  },
  // Contact form: approximate per-IP limit (5 per 60 s per Cloudflare location).
  // A backstop alongside Turnstile and a WAF rule, not a strict guarantee.
  "ratelimits": [
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "vars": {
    "CONTACT_FROM": "Jonathan Bontile Portfolio <portfolio@notify.bontilebiz.com>"
  }
  // Secrets (never in this file), set with `npx wrangler secret put <NAME>`:
  //   TURNSTILE_SECRET_KEY   Turnstile widget secret
  //   RESEND_API_KEY         Resend key with "Sending access" for notify.bontilebiz.com only
  //   CONTACT_TO             inbox that receives inquiries
  // Until all three exist, /api/contact answers 503 "not_available_yet".
}
